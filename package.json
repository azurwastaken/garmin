{
  "name": "garmin",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "backfill": "node src/export.ts",
    "build": "vite build",
    "check": "./scripts/check.sh",
    "db:generate": "drizzle-kit generate --name",
    "db:generate:auth": "drizzle-kit generate --config drizzle.auth.config.ts --name",
    "dev": "vite dev",
    "fix": "oxfmt . && oxlint --quiet --type-aware --fix --fix-dangerously --fix-suggestions",
    "format": "oxfmt --check",
    "garmin": "node src/garmin/cli.ts",
    "ingest": "node src/ingest.ts",
    "lint": "oxlint --quiet --type-aware",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.4",
    "@garmin/fitsdk": "21.221.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@orpc/client": "2.0.0-beta.51",
    "@orpc/json-schema": "2.0.0-beta.51",
    "@orpc/mcp": "2.0.0-beta.51",
    "@orpc/openapi": "2.0.0-beta.51",
    "@orpc/server": "2.0.0-beta.51",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "4.1.4",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.4",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "1.0.0-rc.5",
    "nitro": "3.0.261103-rc",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "yazl": "3.3.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.13.1",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.21.0"
}
